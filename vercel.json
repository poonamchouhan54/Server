{
  "rewrites": [
    { "source": "/api/code/:path*", "destination": "/api/code.js" },
    { "source": "/api/nc", "destination": "/api/nc" },
    { "source": "/nc", "destination": "/api/nc" },
    { "source": "/api/prsearch", "destination": "/api/prsearch" },
    { "source": "/search/(.*)", "destination": "/api/prsearch" },
    { "source": "/search", "destination": "/api/prsearch" },
    { "source": "/((?!api/).*)", "destination": "/api/prsearch" }
  ]
}
